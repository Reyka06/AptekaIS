<Window x:Class="AptekaIS.Views.AddEditSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставщик"
        Height="550"
        Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Информация о поставщике"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}"
                   Margin="0,0,0,20"/>

        <!-- Основной блок -->
        <Border Grid.Row="1"
                Style="{StaticResource InputBorderStyle}"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Название -->
                <TextBlock Text="Название"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="NameTextBox"
                         Grid.Row="1"
                         Height="35"
                         Margin="0,5,0,15"
                         Style="{StaticResource ModernTextBoxStyle}"/>

                <!-- Контакты -->
                <TextBlock Grid.Row="2"
                           Text="Контакты"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="ContactInfoTextBox"
                         Grid.Row="3"
                         Height="35"
                         Margin="0,5,0,15"
                         Style="{StaticResource ModernTextBoxStyle}"/>

                <!-- Производители -->
                <TextBlock Grid.Row="4"
                           Text="Производители, с которыми работает поставщик"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="5"
                        Background="#FAFAFA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="250">
                        <ItemsControl x:Name="ManufacturersList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="350"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Left"
                                              Margin="0,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Отмена"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Width="130"
                    Height="35"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>