<UserControl x:Class="AptekaIS.Views.UserControls.WriteOffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ КНОПОК -->
        <WrapPanel Grid.Row="0"
                   Margin="0,0,0,15">

            <Button x:Name="NewWriteOffButton"
                    Content="Добавить"
                    Width="150"
                    Margin="0,0,10,10"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="NewWriteOffButton_Click"/>

            <Button x:Name="EditWriteOffButton"
                    Content="Редактировать"
                    Width="150"
                    Margin="0,0,10,10"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="EditWriteOff_Click"/>

            <Button x:Name="DeleteWriteOffButton"
                    Content="Удалить"
                    Width="150"
                    Margin="0,0,10,10"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteWriteOff_Click"/>

        </WrapPanel>

        <!-- ТАБЛИЦА СПИСАНИЙ -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="1">

            <DataGrid x:Name="WriteOffsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="№"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding WriteOffDate, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Товар"
                                        Binding="{Binding ProductName}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Quantity}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Причина"
                                        Binding="{Binding Reason}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Кто списал"
                                        Binding="{Binding UserName}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>