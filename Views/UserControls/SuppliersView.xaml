<UserControl x:Class="AptekaIS.Views.UserControls.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- SEARCH -->
        <Border Grid.Row="1"
        Background="White"
        CornerRadius="8"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        Padding="5"
        Margin="0,0,0,10">

            <TextBox x:Name="SearchTextBox"
             Height="35"
             BorderThickness="0"
             Background="Transparent"
             FontSize="14"
             VerticalContentAlignment="Center"
             TextChanged="SearchTextBox_TextChanged"
             Style="{StaticResource ModernTextBoxStyle}"/>
        </Border>

        <!-- BUTTONS -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,15">

            <Button x:Name="AddButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Добавить"
                    Width="150"
                    Margin="0,0,10,10"
                    Click="AddButton_Click"/>

            <Button x:Name="EditButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Редактировать"
                    Width="150"
                    Margin="0,0,10,10"
                    Click="EditButton_Click"/>

            <Button x:Name="DeleteButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Content="Удалить"
                    Width="150"
                    Margin="0,0,10,10"
                    Click="DeleteButton_Click"/>

        </WrapPanel>

        <!-- TABLE -->
        <Border Grid.Row="3"
                Style="{StaticResource InputBorderStyle}"
                Padding="0">

            <DataGrid x:Name="SuppliersGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="42"
                      FontSize="13"
                      BorderThickness="0"
                      AlternationCount="2">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Контакты"
                                        Binding="{Binding ContactInfo}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>